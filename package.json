{
  "name": "runyard",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted dashboard and control service for GitHub Actions and Forgejo runner fleets",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run -r --parallel dev",
    "ci": "vp run ready && vp run @runyard/cli#smoke",
    "release": "vp run ready && vp run @runyard/cli#release"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
