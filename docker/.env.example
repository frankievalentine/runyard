# A Tailscale auth key (admin console ▸ Settings ▸ Keys). Reusable keys aren't needed.
TS_AUTHKEY=
# The machine name on your tailnet: Runyard is at https://<name>.<tailnet>.ts.net:7443/
RUNYARD_HOSTNAME=runyard
# The SSH directory to copy keys, config and known_hosts from (read-only).
RUNYARD_SSH_DIR=~/.ssh
# The image tag to run; pin a version to upgrade deliberately.
RUNYARD_VERSION=latest
