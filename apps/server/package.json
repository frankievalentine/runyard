{
  "name": "@runyard/server",
  "version": "0.0.0",
  "private": true,
  "description": "Runyard control service: forge and machine polling, desired-state engine, and the HTTP API that serves the dashboard",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "build": "bun build --compile src/main.ts --outfile dist/runyard"
  },
  "dependencies": {
    "@runyard/core": "workspace:*",
    "hono": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
